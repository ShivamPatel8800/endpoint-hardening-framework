{
  "metadata": {
    "name": "ESHF macOS (Apple Silicon) Baseline",
    "version": "1.1.0",
    "platform": "macos",
    "description": "Hardening checks for macOS endpoints, CIS Apple macOS-inspired. Verified on Apple Silicon."
  },
  "checks": [
    {
      "id": "ESHF-MAC-0001",
      "title": "System Integrity Protection (SIP) is enabled",
      "category": "system-integrity",
      "severity": "critical",
      "type": "command",
      "params": {
        "cmd": "csrutil status",
        "pattern": "System Integrity Protection status:\\s*(\\w+)",
        "group": 1, "operator": "eq", "expected": "enabled"
      },
      "remediation": {
        "type": "manual",
        "description": "Restart into macOS Recovery, open Terminal, run: csrutil enable"
      }
    },
    {
      "id": "ESHF-MAC-0002",
      "title": "Gatekeeper assessments are enabled",
      "category": "application-control",
      "severity": "high",
      "type": "command",
      "params": {
        "cmd": "spctl --status",
        "pattern": "assessments\\s+(\\w+)",
        "group": 1, "operator": "eq", "expected": "enabled"
      },
      "remediation": {
        "type": "command",
        "cmd": "spctl --master-enable",
        "description": "sudo spctl --master-enable (on managed Macs prefer a configuration profile)"
      }
    },
    {
      "id": "ESHF-MAC-0003",
      "title": "FileVault full-disk encryption is on",
      "category": "encryption",
      "severity": "high",
      "type": "command",
      "params": {
        "cmd": "fdesetup status",
        "pattern": "FileVault is (On|Off)",
        "group": 1, "operator": "eq", "expected": "On"
      },
      "remediation": {
        "type": "manual",
        "description": "System Settings → Privacy & Security → FileVault → Turn On (or: sudo fdesetup enable)"
      }
    },
    {
      "id": "ESHF-MAC-0004",
      "title": "Application firewall is enabled",
      "category": "network",
      "severity": "high",
      "type": "command",
      "params": {
        "cmd": "/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate",
        "pattern": "State\\s*=\\s*(\\d+)",
        "group": 1, "operator": "eq", "expected": "1"
      },
      "remediation": {
        "type": "command",
        "cmd": "/usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on",
        "description": "Enable the application firewall (needs sudo)"
      }
    },
    {
      "id": "ESHF-MAC-0005",
      "title": "Firewall stealth mode is enabled",
      "category": "network",
      "severity": "medium",
      "type": "command",
      "params": {
        "cmd": "/usr/libexec/ApplicationFirewall/socketfilterfw --getstealthmode",
        "pattern": "(?i)stealth mode\\s+(enabled|disabled)",
        "group": 1, "operator": "eq", "expected": "enabled"
      },
      "remediation": {
        "type": "command",
        "cmd": "/usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on",
        "description": "Enable stealth mode so the Mac does not respond to probes (needs sudo)"
      }
    },
    {
      "id": "ESHF-MAC-0006",
      "title": "Firewall logging is on",
      "category": "logging",
      "severity": "low",
      "type": "command",
      "params": {
        "cmd": "/usr/libexec/ApplicationFirewall/socketfilterfw --getloggingmode",
        "pattern": "(?i)logging mode:\\s*(\\w+)",
        "group": 1, "operator": "eq", "expected": "on"
      },
      "remediation": {
        "type": "command",
        "cmd": "/usr/libexec/ApplicationFirewall/socketfilterfw --setloggingmode on",
        "description": "Enable firewall logging (needs sudo)"
      }
    },
    {
      "id": "ESHF-MAC-0007",
      "title": "Automatic update checking is enabled",
      "category": "updates",
      "severity": "high",
      "type": "command",
      "params": {
        "cmd": "defaults read /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled",
        "operator": "eq", "expected": "1"
      },
      "remediation": {
        "type": "command",
        "cmd": "defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool true",
        "description": "Enable automatic update checks (needs sudo)"
      }
    },
    {
      "id": "ESHF-MAC-0008",
      "title": "Automatic update download is enabled",
      "category": "updates",
      "severity": "medium",
      "type": "command",
      "params": {
        "cmd": "defaults read /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload",
        "operator": "eq", "expected": "1"
      },
      "remediation": {
        "type": "command",
        "cmd": "defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool true",
        "description": "Enable automatic download of updates (needs sudo)"
      }
    },
    {
      "id": "ESHF-MAC-0009",
      "title": "Critical/security update install is enabled",
      "category": "updates",
      "severity": "high",
      "type": "command",
      "params": {
        "cmd": "defaults read /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall",
        "operator": "eq", "expected": "1"
      },
      "remediation": {
        "type": "command",
        "cmd": "defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool true",
        "description": "Install critical security updates automatically (needs sudo)"
      }
    },
    {
      "id": "ESHF-MAC-0010",
      "title": "Automatic login is disabled",
      "category": "access-control",
      "severity": "high",
      "type": "command",
      "params": {
        "cmd": "defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>&1",
        "pattern": "does not exist", "operator": "present"
      },
      "remediation": {
        "type": "command",
        "cmd": "defaults delete /Library/Preferences/com.apple.loginwindow autoLoginUser",
        "description": "Remove the auto-login user (needs sudo; fails harmlessly if already unset)"
      }
    },
    {
      "id": "ESHF-MAC-0011",
      "title": "Guest account is disabled",
      "category": "access-control",
      "severity": "medium",
      "type": "command",
      "params": {
        "cmd": "defaults read /Library/Preferences/com.apple.loginwindow GuestEnabled 2>&1",
        "pattern": "(does not exist|^0$)",
        "group": 1, "operator": "in", "expected": ["does not exist", "0"]
      },
      "remediation": {
        "type": "command",
        "cmd": "defaults write /Library/Preferences/com.apple.loginwindow GuestEnabled -bool false",
        "description": "Disable the guest account (needs sudo)"
      }
    },
    {
      "id": "ESHF-MAC-0012",
      "title": "Screen saver requires password (current user)",
      "category": "access-control",
      "severity": "medium",
      "type": "command",
      "params": {
        "cmd": "defaults -currentHost read com.apple.screensaver askForPassword 2>&1",
        "operator": "eq", "expected": "1"
      },
      "remediation": {
        "type": "manual",
        "description": "Per-user setting — run WITHOUT sudo: defaults -currentHost write com.apple.screensaver askForPassword -int 1 (or System Settings → Lock Screen)"
      }
    },
    {
      "id": "ESHF-MAC-0013",
      "title": "Screen-saver password delay is 300s or less (current user)",
      "category": "access-control",
      "severity": "low",
      "type": "command",
      "params": {
        "cmd": "defaults -currentHost read com.apple.screensaver askForPasswordDelay 2>&1",
        "operator": "le", "expected": 300
      },
      "remediation": {
        "type": "manual",
        "description": "Per-user setting — run WITHOUT sudo: defaults -currentHost write com.apple.screensaver askForPasswordDelay -int 300"
      }
    },
    {
      "id": "ESHF-MAC-0014",
      "title": "SSH: root login disabled (if Remote Login is used)",
      "category": "ssh",
      "severity": "high",
      "optional": true,
      "type": "file_content",
      "params": {
        "path": "/etc/ssh/sshd_config",
        "pattern": "^\\s*PermitRootLogin\\s+no\\s*$",
        "operator": "present"
      },
      "remediation": {
        "type": "file_line",
        "path": "/etc/ssh/sshd_config",
        "pattern": "^\\s*#?\\s*PermitRootLogin\\s",
        "line": "PermitRootLogin no",
        "description": "Ensure 'PermitRootLogin no', then: sudo launchctl stop com.openssh.sshd && sudo launchctl start com.openssh.sshd"
      }
    },
    {
      "id": "ESHF-MAC-0015",
      "title": "SSH: password authentication disabled (if Remote Login is used)",
      "category": "ssh",
      "severity": "high",
      "optional": true,
      "type": "file_content",
      "params": {
        "path": "/etc/ssh/sshd_config",
        "pattern": "^\\s*PasswordAuthentication\\s+no\\s*$",
        "operator": "present"
      },
      "remediation": {
        "type": "file_line",
        "path": "/etc/ssh/sshd_config",
        "pattern": "^\\s*#?\\s*PasswordAuthentication\\s",
        "line": "PasswordAuthentication no",
        "description": "Ensure key-based SSH only, then restart sshd"
      }
    },
    {
      "id": "ESHF-MAC-0016",
      "title": "SSH: MaxAuthTries is 4 or fewer (if Remote Login is used)",
      "category": "ssh",
      "severity": "medium",
      "optional": true,
      "type": "file_content",
      "params": {
        "path": "/etc/ssh/sshd_config",
        "pattern": "^\\s*MaxAuthTries\\s+(\\d+)",
        "group": 1, "operator": "le", "expected": 4
      },
      "remediation": {
        "type": "file_line",
        "path": "/etc/ssh/sshd_config",
        "pattern": "^\\s*#?\\s*MaxAuthTries\\s",
        "line": "MaxAuthTries 4",
        "description": "Set MaxAuthTries 4, then restart sshd"
      }
    },
    {
      "id": "ESHF-MAC-0017",
      "title": "No NFS exports configured",
      "category": "network",
      "severity": "low",
      "optional": true,
      "type": "file_content",
      "params": { "path": "/etc/exports", "pattern": "\\S", "operator": "absent" }
    },
    {
      "id": "ESHF-MAC-0018",
      "title": "IPv4 forwarding is disabled",
      "category": "network",
      "severity": "medium",
      "type": "sysctl",
      "params": { "key": "net.inet.ip.forwarding", "operator": "eq", "expected": 0 }
    },
    {
      "id": "ESHF-MAC-0019",
      "title": "ICMP redirects are not accepted",
      "category": "network",
      "severity": "medium",
      "type": "sysctl",
      "params": { "key": "net.inet.ip.accept_redirects", "operator": "eq", "expected": 0 },
      "remediation": {
        "type": "command",
        "cmd": "sysctl -w net.inet.ip.accept_redirects=0",
        "description": "sudo sysctl -w net.inet.ip.accept_redirects=0 (persist via a LaunchDaemon, macOS ignores /etc/sysctl.conf on modern releases)"
      }
    },
    {
      "id": "ESHF-MAC-0020",
      "title": "TCP blackhole mode for refused connections is 2",
      "category": "network",
      "severity": "medium",
      "type": "sysctl",
      "params": { "key": "net.inet.tcp.blackhole", "operator": "eq", "expected": 2 },
      "remediation": {
        "type": "command",
        "cmd": "sysctl -w net.inet.tcp.blackhole=2",
        "description": "sudo sysctl -w net.inet.tcp.blackhole=2 (persist via a LaunchDaemon)"
      }
    },
    {
      "id": "ESHF-MAC-0021",
      "title": "XProtect malware definitions are present",
      "category": "malware-defense",
      "severity": "info",
      "type": "command",
      "params": {
        "cmd": "ls -d /Library/Apple/System/Library/CoreServices/XProtect.bundle /System/Library/CoreServices/XProtect.bundle 2>/dev/null || echo missing",
        "pattern": "XProtect\\.bundle", "operator": "present"
      }
    }
  ]
}
